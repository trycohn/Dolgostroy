    speaker: 
    text: "\u0421\u043B\u044B\u0448\u0430\u043B\u0430, \u0413\u0440\u0435\u0433\u043E\u0440 \u0440\u0430\u0441\u043F\u043B\u0430\u0442\u0438\u043B\u0441\u044F. \u0427\u0438\u0441\u0442\u043E \u0441\u0440\u0430\u0431\u043E\u0442\u0430\u043D\u043E. \u0421\u0434\u0430\u0432\u0430\u0439 \u0434\u0435\u043B\u043E \u2014 \u0432\u043E\u0442 \u0442\u0432\u043E\u044F \u0434\u043E\u043B\u044F."
