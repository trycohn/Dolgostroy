    requiredCount: 1
    description: "\u0420\u0430\u0441\u0441\u043F\u0440\u043E\u0441\u0438\u0442\u044C \u0418\u0432\u0430\u043D\u0430 \u0432 \u0430\u0440\u0445\u0438\u0432\u0435"
